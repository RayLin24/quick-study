# ===== LLM 生成模型（M2 起用）=====
# Anthropic 兼容端点（K3 走该协议）
ANTHROPIC_BASE_URL=https://your-endpoint
ANTHROPIC_AUTH_TOKEN=sk-xxx
QUICKSTUDY_LLM_MODEL=k3

# ===== Embedding（M2 起用，阿里百炼 DashScope，OpenAI 兼容模式）=====
DASHSCOPE_API_KEY=sk-xxx
QUICKSTUDY_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUICKSTUDY_EMBED_MODEL=text-embedding-v4

# ===== 抓取行为 =====
QUICKSTUDY_MAX_RPS=5            # 每域名令牌桶速率
QUICKSTUDY_USER_AGENT=quickstudy/0.1 (+https://github.com/your-org/quick-study; doc-crawler)
