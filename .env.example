# Copy this file to .env for local development. Replace every password placeholder.
# The API and the worker both read the repository-root .env, whatever their working
# directory is, so a single copy configures every local process.
COMPOSE_PROJECT_NAME=quick-study

WEB_PORT=3000
API_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=quickstudy
MYSQL_USER=quickstudy
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# The API and worker compose their connection string from the MYSQL_* values above as
# mysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:MYSQL_PORT/MYSQL_DATABASE, percent-encoding
# the credentials. Uncomment DATABASE_URL only to target a database Compose does not manage.
# DATABASE_URL=mysql://quickstudy:replace-with-a-local-password@127.0.0.1:3306/quickstudy

# Defaults match the published Compose ports. Override when you change REDIS_PORT or keep
# artifacts outside the repository; a relative ARTIFACTS_DIR resolves against the repo root.
# REDIS_URL=redis://127.0.0.1:6379/0
# ARTIFACTS_DIR=data/artifacts

# LangGraph checkpoints hold graph execution state so a restarted worker can pick a run
# back up; every business fact stays in the tables above. They share the application
# database unless CHECKPOINTER_URL names another one. "memory" keeps them in the process
# and loses every in-flight run on restart, so use it only for single-process development.
# CHECKPOINTER_BACKEND=mysql
# CHECKPOINTER_URL=mysql+pymysql://quickstudy:replace-with-a-local-password@127.0.0.1:3306/quickstudy

# Session cookies are HttpOnly, SameSite=Lax and Secure. Browsers treat http://localhost as
# a secure context, so the default works for local development too; only set this to false
# when serving plain HTTP over a LAN address.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_NAME=quickstudy_session

# Optional, tests only. Set this to a scratch schema whose name contains "test" to run the
# MySQL-only checks (FULLTEXT search, migrations against real MySQL and the checkpointer
# contract); they are skipped when it is unset. Every one of those schemas, including the
# "_checkpoints" and "_checkpoints_legacy" ones derived from this name, is dropped and
# recreated on every run.
# QUICKSTUDY_TEST_MYSQL_URL=mysql+pymysql://root:password@127.0.0.1:3306/quickstudy_test

# Chat model. A custom gateway (OpenAI-compatible) takes precedence over DeepSeek.
# LLM_API_KEY=
# LLM_BASE_URL=http://127.0.0.1:8001/
# LLM_MODEL=glm-5.3
# LLM_TIMEOUT_SECONDS=180
# DEEPSEEK_API_KEY=
