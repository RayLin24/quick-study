# Default LLM: OpenRouter + GLM 5.3 Flash
# Base URL must NOT include a trailing /v1 — the client appends /v1/chat/completions.
LLM_PROVIDER=OPENROUTER
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_CONCURRENCY=5
LLM_CACHE_DIR=llm_cache
# Stream is off by default to avoid an empty SSE + blocking retry (double billing).
LLM_STREAM=0
LLM_STREAM_FALLBACK=0
# Optional completion cap sent as max_tokens
LLM_MAX_TOKENS=
LLM_CONTEXT_CHARS=100000
LLM_FILE_CHARS=6000

# Job / crawl
JOB_TIMEOUT_SECONDS=3600
JOB_LOG_RING=2000
CRAWL_FILE_THRESHOLD=80
GITHUB_MAX_CONCURRENCY=16
CRAWL_CACHE_DIR=crawl_cache
CRAWL_CACHE_SECONDS=3600
# Optional: restrict --dir / 本机目录 to this root.
# ALLOW_DIR_ROOT=
LLM_EMPTY_STREAM_MAX=2
ASK_MAX_CHARS=24000
ASK_TOP_K=4
# Optional Ask source-file windows from crawl_cache / local *source: paths. Default OFF.
ASK_SOURCE_SNIPPETS=0
ASK_SOURCE_SNIPPET_LINES=40
DEFAULT_LANGUAGE=Chinese

# Required when the web UI binds anything other than 127.0.0.1 / localhost / ::1.

# Optional: Gemini (only used when LLM_PROVIDER=GEMINI)
# GEMINI_API_KEY=
# GEMINI_PROJECT_ID=
# GEMINI_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-pro

# GitHub token for private repos or to avoid anonymous rate limits.
# Environment only — do not put the token on argv (-t is deprecated).
GITHUB_TOKEN=

# Do not expose Docker or --host 0.0.0.0 without this.
QUICK_STUDY_TOKEN=
QUICK_STUDY_READ_TOKEN=
LLM_STRUCTURE_MODEL=
LLM_WRITE_MODEL=
LLM_RPM=30
SLACK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
COMPLETION_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
ALLOW_GIT_HOSTS=
TOKEN_BUDGET_SESSION=0
TOKEN_BUDGET_DAILY=0
QUICK_STUDY_UI_LANG=zh
QUICK_STUDY_DEMO=0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=60
OTEL_TRACES=0
DINGTALK_WEBHOOK_URL=
